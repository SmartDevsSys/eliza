{
    "name": "@elizaos-plugins/plugin-datarennes",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "@elizaos/source": "./src/index.ts",
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@types/node": "^20.9.0",
        "@types/node-fetch": "^2.6.12",
        "tsup": "^8.0.0"
    },
    "scripts": {
        "build": "tsup --format esm --dts --dts-resolve",
        "dev": "tsup --format esm --dts --watch",
        "lint": "biome lint .",
        "lint:fix": "biome check --apply .",
        "format": "biome format .",
        "format:fix": "biome format --write ."
    },
    "peerDependencies": {
        "whatwg-url": "^7.1.0"
    },
    "dependencies": {
        "@elizaos/core": "workspace:*",
        "node-fetch": "^3.3.2"
    },
    "agentConfig": {
        "pluginType": "elizaos:client:1.0.0",
        "pluginParameters": {
            "DEFAULT_LIMIT": {
                "type": "number",
                "default": 20,
                "description": "Default number of results to fetch.",
                "optional": true
            }
        }
    }
}
